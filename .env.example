# Bu dosyayı ".env" adıyla kopyalayıp anahtarı değiştirin:
#   cp .env.example .env
#
# Rastgele anahtar üretmek için (Mac/Linux/WSL):
#   openssl rand -hex 32
# Windows PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#
# Bu anahtar, mail şifreleriniz gibi credential'ları diskte şifreler.
# Kaybederseniz kayıtlı credential'lar açılamaz — güvenli bir yere yedekleyin.
N8N_ENCRYPTION_KEY=BUNU-DEGISTIRIN-openssl-rand-hex-32-ciktisini-yapistirin

# Zamanlanmış workflow'ların saat dilimi.
GENERIC_TIMEZONE=Europe/Istanbul

# ── Telegram görev botu (workflow 05, isteğe bağlı) ─────────────────────────
# 1) Telegram'da @BotFather'a /newbot yazın; verdiği token'ı buraya yapıştırın.
# 2) docker compose up -d ile n8n'i yeniden başlatın, workflow 05'i Active yapın.
# 3) Botunuza /start yazın — size sohbet ID'nizi söyler; aşağıya yazın ve
#    n8n'i bir kez daha yeniden başlatın. ID doluyken bot yalnızca sizi dinler
#    ve sabah görev özeti Telegram'dan gelir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Günaydın brifingi (workflow 10, isteğe bağlı) ───────────────────────────
# Hava durumu için konumunuz. Boş bırakılırsa İstanbul kullanılır.
# Koordinatları haritadan alabilirsiniz (sağ tık → "buradaki konum").
HAVA_SEHIR=İstanbul
HAVA_ENLEM=41.01
HAVA_BOYLAM=28.98

# ── Yerel AI (workflow 12, 13, 14 — isteğe bağlı) ───────────────────────────
# Ollama'da hangi model kullanılsın. Önce indirin:
#   docker compose --profile ai up -d
#   docker exec -it ollama ollama pull qwen2.5:3b
# GPU'suz makinelerde 3B'den büyük model önerilmez.
OLLAMA_MODEL=qwen2.5:3b

# RSS haber özetinde (workflow 14) başlıklar yerel AI'ya da gönderilsin mi?
# 1 = evet, boş = hayır (haber listesi yine gelir).
RSS_AI_OZET=

# ── GitHub nöbetçisi (workflow 18, isteğe bağlı) ────────────────────────────
# İncelemenizi bekleyen PR'lar, CI'ı kırık kendi PR'larınız, size atanmış
# issue'lar ve adınızın geçtiği konular için bildirim.
#   GitHub → Settings → Developer settings → Personal access tokens
# Gereken tek yetki OKUMA'dır (classic token için: repo + notifications;
# yalnızca açık depoları izleyecekseniz yetkisiz token da yeter).
# Boş bırakılırsa workflow 18 sessizce hiçbir şey yapmaz.
GITHUB_TOKEN=

# Kendi hesabınız yerine başka bir kullanıcıyı izlemek isterseniz doldurun.
# Boşsa token'ın sahibi (@me) kullanılır.
GITHUB_KULLANICI=

# ── Otomatik yedekleme (workflow 15, isteğe bağlı) ──────────────────────────
# Workflow'ların kendisini de yedeklemek için panel API anahtarı:
#   Panel → profil → Settings → n8n API → Create an API key
# Boş bırakılırsa yalnızca local-files/ klasörü yedeklenir.
N8N_API_KEY=
