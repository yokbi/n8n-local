# Bu dosyayı ".env" adıyla kopyalayıp anahtarı değiştirin:
#   cp .env.example .env
#
# Rastgele anahtar üretmek için (Mac/Linux/WSL):
#   openssl rand -hex 32
# Windows PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#
# Bu anahtar, mail şifreleriniz gibi credential'ları diskte şifreler.
# Kaybederseniz kayıtlı credential'lar açılamaz — güvenli bir yere yedekleyin.
N8N_ENCRYPTION_KEY=BUNU-DEGISTIRIN-openssl-rand-hex-32-ciktisini-yapistirin

# Zamanlanmış workflow'ların saat dilimi.
GENERIC_TIMEZONE=Europe/Istanbul

# ── Telegram görev botu (workflow 05, isteğe bağlı) ─────────────────────────
# 1) Telegram'da @BotFather'a /newbot yazın; verdiği token'ı buraya yapıştırın.
# 2) docker compose up -d ile n8n'i yeniden başlatın, workflow 05'i Active yapın.
# 3) Botunuza /start yazın — size sohbet ID'nizi söyler; aşağıya yazın ve
#    n8n'i bir kez daha yeniden başlatın. ID doluyken bot yalnızca sizi dinler
#    ve sabah görev özeti Telegram'dan gelir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
