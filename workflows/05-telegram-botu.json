      "id": "0ba847e2-2f85-48ec-b83b-50641ee9d37e",
      "name": "Offset Dosyasını Oku",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        240,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
