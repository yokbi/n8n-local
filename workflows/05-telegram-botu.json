    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "9e958f96-10e4-456e-9f84-4cd7465e3110",
      "name": "Görevleri Çıkar (Bot)",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1040,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Telegram'dan gelen yeni mesajları görev komutları olarak işler.\nconst yanitHttp = $('Yeni Mesajları Getir').first().json || {};\nconst okunanGorev = $input.first().json;\nconst g0 = (okunanGorev.data && okunanGorev.data.gorevler) || [];\nconst gorevler = Array.isArray(g0) ? [...g0] : [];\nconst offsetJson = $('Offseti Çıkar').first().json;\nconst eskiOffset = Number((offsetJson.data && offsetJson.data.offset) || 0);\nconst izinliChat = String($env.TELEGRAM_CHAT_ID || '').trim();\n\nconst updates = yanitHttp.ok && Array.isArray(yanitHttp.result) ? yanitHttp.result : [];\nlet yeniOffset = eskiOffset;\nlet degisti = false;\nconst yanitlar = [];\n\nconst acikListe = () => {\n  const acik = gorevler.filter((x) => x.durum !== 'tamam');\n  if (acik.length === 0) return 'Açık görev yok. 🎉';\n  return 'Açık görevler:\\n' + acik.map((x) => '#' + x.id + ' ' + x.baslik + (x.not ? ' — ' + x.not : '')).join('\\n');\n};\n\nfor (const u of updates) {\n  if (typeof u.update_id === 'number' && u.update_id >= yeniOffset) yeniOffset = u.update_id + 1;\n  const m = u.message;\n  if (!m || !m.chat) continue;\n  const chatId = m.chat.id;\n  if (izinliChat && String(chatId) !== izinliChat) continue; // yabancı sohbetleri yok say\n  const metin = String(m.text || '').trim();\n  if (!metin) {\n    yanitlar.push({ chat_id: chatId, text: 'Metin mesajı bekliyorum. Komutlar için /yardim yazın.' });\n    continue;\n  }\n  const kucuk = metin.toLowerCase();\n  const esle = kucuk.match(/^\\/?(tamamla|sil)\\s+#?(\\d+)/);\n  if (kucuk === '/start' || kucuk === '/yardim' || kucuk === 'yardim' || kucuk === 'yardım') {\n    yanitlar.push({\n      chat_id: chatId,\n      text: [\n        'Merhaba! Görev botu komutları:',\n        '• Düz metin yaz → görev olarak eklenir',\n        '• /liste → açık görevleri gösterir',\n        '• /tamamla 3 → #3 numaralı görevi tamamlar',\n        '• /sil 3 → #3 numaralı görevi siler',\n        '',\n        'Sohbet ID: ' + chatId,\n        'Sabah özeti ve güvenlik için .env dosyasına TELEGRAM_CHAT_ID=' + chatId + ' yazıp n8n\\'i yeniden başlatın.',\n      ].join('\\n'),\n    });\n  } else if (kucuk === '/liste' || kucuk === 'liste' || kucuk === '/gorevler') {\n    yanitlar.push({ chat_id: chatId, text: acikListe() });\n  } else if (esle) {\n    const id = Number(esle[2]);\n    const gorev = gorevler.find((x) => Number(x.id) === id);\n    if (!gorev) {\n      yanitlar.push({ chat_id: chatId, text: '#' + id + ' bulunamadı. /liste ile kontrol edin.' });\n    } else if (esle[1] === 'tamamla') {\n      gorev.durum = 'tamam';\n      gorev.tamamlanma = new Date().toISOString();\n      degisti = true;\n      yanitlar.push({ chat_id: chatId, text: '✅ Tamamlandı: #' + id + ' ' + gorev.baslik + '\\n' + acikListe() });\n    } else {\n      gorevler.splice(gorevler.indexOf(gorev), 1);\n      degisti = true;\n      yanitlar.push({ chat_id: chatId, text: '🗑 Silindi: #' + id + ' ' + gorev.baslik });\n    }\n  } else {\n    const yeniId = gorevler.reduce((mx, x) => Math.max(mx, Number(x.id) || 0), 0) + 1;\n    gorevler.push({ id: yeniId, baslik: metin, not: '', durum: 'acik', olusturulma: new Date().toISOString() });\n    degisti = true;\n    yanitlar.push({ chat_id: chatId, text: '➕ Eklendi: #' + yeniId + ' ' + metin });\n  }\n}\n\nreturn [{\n  json: {\n    gorevler,\n    yanitlar,\n    yeniOffset,\n    gorevYazilsin: degisti,\n    offsetYazilsin: yeniOffset !== eskiOffset,\n  },\n}];"
      },
