    {
      "parameters": {
        "jsCode": "// Açık görevlerden sabah özet mesajı hazırlar.\nconst okunan = $input.first().json;\nconst g0 = (okunan.data && okunan.data.gorevler) || [];\nconst gorevler = Array.isArray(g0) ? g0 : [];\nconst acik = gorevler.filter((x) => x && x.durum !== 'tamam');\nconst bugun = new Date().toLocaleDateString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long' });\nlet text;\nif (acik.length === 0) {\n  text = '📋 Günaydın! ' + bugun + '\\nAçık görev yok. 🎉';\n} else {\n  text = '📋 Günaydın! ' + bugun + '\\nAçık görevler (' + acik.length + '):\\n' +\n    acik.map((x) => '#' + x.id + ' ' + x.baslik + (x.not ? ' — ' + x.not : '')).join('\\n') +\n    '\\n\\nTamamlamak için: /tamamla <numara>';\n}\nreturn [{ json: { chat_id: String($env.TELEGRAM_CHAT_ID).trim(), text } }];"
      },
