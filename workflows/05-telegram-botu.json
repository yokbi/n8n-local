    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/getUpdates?timeout=0&offset=' + (($json.data && $json.data.offset) || 0) }}",
        "options": {
