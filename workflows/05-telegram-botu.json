      "id": "735ee459-634a-42dc-bb29-a1f65c4d535b",
      "name": "Görev Dosyasını Oku (Bot)",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        840,
        120
      ],
      "onError": "continueRegularOutput"
