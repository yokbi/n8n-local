        "jsCode": "// Token veya sohbet ID .env dosyasında yoksa sabah özeti sessizce atlanır.\nif (!String($env.TELEGRAM_BOT_TOKEN || '').trim() || !String($env.TELEGRAM_CHAT_ID || '').trim()) return [];\nreturn [{ json: {} }];"
